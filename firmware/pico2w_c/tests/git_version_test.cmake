find_package(Git REQUIRED)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef suffix)
set(repo "${CMAKE_CURRENT_BINARY_DIR}/version-fixture-${suffix}")
file(MAKE_DIRECTORY "${repo}")
function(git_run)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" ${ARGV}
        RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Git fixture failed: ${ARGV}: ${error}")
    endif()
endfunction()
function(generate_version root)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DCLOCK_SOURCE_ROOT=${root}"
        "-DCLOCK_VERSION_TEMPLATE=${SOURCE_DIR}/firmware_version.h.in"
        "-DCLOCK_VERSION_HEADER=${repo}/generated/firmware_version.h"
        -DCLOCK_BUILD_PROFILE=-bt-mp3-wifi
        "-DCLOCK_VERSION_ID_FILE=${repo}/generated/id.txt"
        -P "${SOURCE_DIR}/cmake/git_version.cmake"
        RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Version generation failed: ${error}")
    endif()
    file(READ "${repo}/generated/firmware_version.h" header)
    string(REGEX MATCH "CLOCK_FIRMWARE_VERSION \"([^\"]+)\"" unused "${header}")
    set(version "${CMAKE_MATCH_1}" PARENT_SCOPE)
    string(REGEX MATCH "CLOCK_DISPLAY_VERSION \"([^\"]+)\"" unused "${header}")
    set(display "${CMAKE_MATCH_1}" PARENT_SCOPE)
    string(REGEX MATCH "CLOCK_BUILD_ID \"([^\"]+)\"" unused "${header}")
    set(identity "${CMAKE_MATCH_1}" PARENT_SCOPE)
    file(READ "${repo}/generated/id.txt" sidecar)
    if(NOT sidecar STREQUAL "${CMAKE_MATCH_1}\n")
        message(FATAL_ERROR "Header and build-ID sidecar disagree")
    endif()
endfunction()
function(expect actual pattern)
    if(NOT "${actual}" MATCHES "${pattern}")
        message(FATAL_ERROR "Expected /${pattern}/, got '${actual}'")
    endif()
endfunction()
git_run(init)
git_run(config user.name "Version Test")
git_run(config user.email "version@example.invalid")
git_run(config commit.gpgsign false)
git_run(config tag.gpgsign false)
file(WRITE "${repo}/tracked.txt" "initial\n")
git_run(add tracked.txt)
git_run(commit -m initial)
generate_version("${repo}")
expect("${version}" "^0\\.0\\.0\\+g[0-9a-f]+$")
git_run(tag v1.0.0-rc.1)
generate_version("${repo}")
expect("${version}" "^1\\.0\\.0-rc\\.1$")
expect("${identity}" "^[0-9a-f]+-bt-mp3-wifi$")
expect("${display}" "^1\\.0\\.0-rc\\.1$")
file(APPEND "${repo}/tracked.txt" "changed\n")
generate_version("${repo}")
expect("${version}" "^1\\.0\\.0-rc\\.1\\+0\\.g[0-9a-f]+\\.dirty$")
expect("${display}" "^1\\.0\\.0-rc\\.1\\+$")
expect("${identity}" "^[0-9a-f]+-dirty-bt-mp3-wifi$")
git_run(add tracked.txt)
git_run(commit -m next)
git_run(tag v999-not-a-release)
generate_version("${repo}")
expect("${version}" "^1\\.0\\.0-rc\\.1\\+1\\.g[0-9a-f]+$")
# A new annotated tag on unchanged HEAD must be picked up without a new cache.
git_run(tag -a v1.0.0 -m release)
generate_version("${repo}")
expect("${version}" "^1\\.0\\.0$")
expect("${display}" "^1\\.0\\.0$")
file(WRITE "${repo}/untracked.txt" "build output must not make a release dirty\n")
generate_version("${repo}")
expect("${version}" "^1\\.0\\.0$")
# An archive nested inside another checkout must not borrow that checkout's tags.
file(MAKE_DIRECTORY "${repo}/archive")
generate_version("${repo}/archive")
expect("${version}" "^0\\.0\\.0\\+unknown$")
expect("${identity}" "^source-archive-bt-mp3-wifi$")
message(STATUS "Git version scenarios passed")
