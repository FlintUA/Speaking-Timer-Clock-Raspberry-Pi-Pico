# Run at configure time and before compilation; do not cache Git-derived values.
find_package(Git QUIET)
set(CLOCK_FIRMWARE_VERSION "0.0.0+unknown")
set(CLOCK_DISPLAY_VERSION "0.0.0+")
set(CLOCK_BUILD_ID "source-archive")
if(GIT_FOUND AND EXISTS "${CLOCK_SOURCE_ROOT}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CLOCK_SOURCE_ROOT}"
        rev-parse --short=12 HEAD OUTPUT_VARIABLE revision
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE git_result)
    if(git_result EQUAL 0)
        set(CLOCK_BUILD_ID "${revision}")
        set(CLOCK_FIRMWARE_VERSION "0.0.0+g${revision}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CLOCK_SOURCE_ROOT}"
            tag --list "v[0-9]*" OUTPUT_VARIABLE tags
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        string(REPLACE "\n" ";" tags "${tags}")
        set(matches)
        foreach(tag IN LISTS tags)
            if(tag MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$")
                list(APPEND matches --match "${tag}")
            endif()
        endforeach()
        if(matches)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CLOCK_SOURCE_ROOT}"
                describe --tags --long --abbrev=7 ${matches} HEAD
                OUTPUT_VARIABLE description OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE describe_result)
            if(describe_result EQUAL 0 AND description MATCHES "^v(.+)-([0-9]+)-g([0-9a-f]+)$")
                set(base "${CMAKE_MATCH_1}")
                set(distance "${CMAKE_MATCH_2}")
                set(revision "${CMAKE_MATCH_3}")
                set(CLOCK_FIRMWARE_VERSION "${base}")
                set(CLOCK_DISPLAY_VERSION "${base}")
                if(NOT distance STREQUAL "0")
                    string(APPEND CLOCK_FIRMWARE_VERSION "+${distance}.g${revision}")
                    string(APPEND CLOCK_DISPLAY_VERSION "+")
                endif()
            endif()
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${CLOCK_SOURCE_ROOT}"
            status --porcelain --untracked-files=no OUTPUT_VARIABLE dirty
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(dirty)
            string(APPEND CLOCK_BUILD_ID "-dirty")
            if(CLOCK_FIRMWARE_VERSION MATCHES "\\+")
                string(APPEND CLOCK_FIRMWARE_VERSION ".dirty")
            else()
                string(APPEND CLOCK_FIRMWARE_VERSION "+0.g${revision}.dirty")
            endif()
            if(NOT CLOCK_DISPLAY_VERSION MATCHES "\\+$")
                string(APPEND CLOCK_DISPLAY_VERSION "+")
            endif()
        endif()
    endif()
endif()
string(APPEND CLOCK_BUILD_ID "${CLOCK_BUILD_PROFILE}")
configure_file("${CLOCK_VERSION_TEMPLATE}" "${CLOCK_VERSION_HEADER}" @ONLY)
if(CLOCK_VERSION_ID_FILE)
    set(previous_id "")
    if(EXISTS "${CLOCK_VERSION_ID_FILE}")
        file(READ "${CLOCK_VERSION_ID_FILE}" previous_id)
    endif()
    if(NOT previous_id STREQUAL "${CLOCK_BUILD_ID}\n")
        file(WRITE "${CLOCK_VERSION_ID_FILE}" "${CLOCK_BUILD_ID}\n")
    endif()
endif()
message(STATUS "Clock version: ${CLOCK_FIRMWARE_VERSION}")
